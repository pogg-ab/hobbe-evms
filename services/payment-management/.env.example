# Database configuration
DB_HOST=your_db_host_here
DB_PORT=your_db_port_here
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# Kafka broker URL
KAFKA_BROKER=127.0.0.1:9092

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here

# Wise API configuration
WISE_API_KEY=your_wise_api_key_here
WISE_API_URL=your_wise_api_url_here

# Chapa payment gateway secrets
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# Callback URLs
CALLBACK_BASE_URL=http://localhost:4002
# For production, uncomment and set the correct URL
# CALLBACK_BASE_URL=https://ms3.merkuz.com

# Stripe secret key
STRIPE_SECRET_KEY=your_stripe_secret_key_here
