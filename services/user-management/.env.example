# Database configuration
DB_HOST=your_db_host_here
DB_PORT=your_db_port_here
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# Kafka broker URL
KAFKA_BROKER=your_kafka_broker_url_here

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here

# Firebase service account credentials file path
FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/firebase-service-account.json

# Email service credentials
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_here

# SMS service configuration
SMS_IDENTIFIER_ID=your_sms_identifier_id_here
SMS_SENDER_NAME=your_sms_sender_name_here
SMS_CALLBACK_URL=your_sms_callback_url_here
SMS_API_URL=https://api.afromessage.com/api/send
SMS_API_TOKEN=your_sms_api_token_here

# NMS (Streaming server) ports and paths
NMS_RTMP_PORT=1935
NMS_HTTP_PORT=8000
NMS_MEDIA_ROOT=./media/

# FFMPEG executable path and docker usage flag
FFMPEG_PATH=C:\\path\\to\\ffmpeg\\bin\\ffmpeg.exe
FFMPEG_DOCKER=true

# Allowed origins for CORS
NMS_ALLOW_ORIGIN=*

# Streaming URLs and paths
RTMP_URL=rtmp://your_streaming_server/live
HLS_OUTPUT_BASE_PATH=../media/hls

# For production, uncomment and set appropriate media root path
# NMS_MEDIA_ROOT=/var/www/media/
